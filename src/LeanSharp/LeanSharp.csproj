<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>LeanSharp</RootNamespace>
    <AssemblyName>LeanSharp</AssemblyName>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <!-- zstd dictionary of leantar (dict/v1.dict of https://github.com/digama0/leangz, Apache-2.0) -->
