  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../LeanSharp.Runtime/LeanSharp.Runtime.csproj" />
    <ProjectReference Include="../LeanSharp.Lean/LeanSharp.Lean.csproj" />
  </ItemGroup>
</Project>
